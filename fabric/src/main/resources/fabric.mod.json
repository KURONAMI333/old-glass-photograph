{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "icon": "${mod_id}.png",
  "authors": ["${mod_author}"],
  "contact": {
    "homepage": "https://github.com/KURONAMI333/old-glass-photograph",
    "issues": "https://github.com/KURONAMI333/old-glass-photograph/issues",
    "sources": "https://github.com/KURONAMI333/old-glass-photograph"
  },
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.kuronami.oldglassphotograph.OldGlassPhotographFabric"],
    "client": ["com.kuronami.oldglassphotograph.client.OldGlassPhotographFabricClient"],
    "jade": ["com.kuronami.oldglassphotograph.integration.jade.OldGlassPhotographJadePlugin"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=${java_version}"
  }
}
